# Copy to backend/.env. Every value is optional: with no key the app runs in demo mode.

# Provider: anthropic | offline. Empty picks anthropic when ANTHROPIC_API_KEY is set, else offline.
LLM_PROVIDER=
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5-5. A public demo would use claude-haiku-5-5.
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium

# Where the SQLite file (runs, steps, events and the job queue) lives.
DATA_DIR=./data

# Frontend origins allowed by CORS (comma separated).
CORS_ORIGINS=http://localhost:3050

# Queue and retries
LEASE_SECONDS=30
RETRY_BASE_SECONDS=2
RETRY_MAX_SECONDS=60

# Outgoing webhook. The default points at the mock receiver inside the API.
WEBHOOK_URL=http://localhost:8050/api/receiver/hooks
WEBHOOK_SECRET=local-dev-secret

# Demo pacing between and inside steps, so a run is easy to follow. 0 runs at full speed.
STEP_DELAY_SECONDS=1.0
